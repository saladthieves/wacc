{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "config-ninja-debug",
            "detail": "Runs cmake with the config-ninja-debug preset",
            "group": "build",
            "command": "cmake",
            "args": [
                "--preset",
                "config-ninja-debug"
            ]
        },
        {
            "type": "shell",
            "label": "config-ninja-debug-clean",
            "detail": "Runs clean and cmake with the config-ninja-debug preset",
            "group": "build",
            "command": "cmake",
            "args": [
                "--preset",
                "config-ninja-debug"
            ],
            "dependsOn": [
                "clean"
            ]
        },
        {
            "type": "shell",
            "label": "build-testing",
            "detail": "Builds unit tests",
            "group": "test",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--preset",
                "build-testing"
            ],
            "dependsOn": [
                "config-ninja-debug"
            ]
        },
        {
            "type": "shell",
            "label": "build-testing-clean",
            "detail": "Cleans and builds unit tests",
            "group": "test",
            "dependsOn": [
                "clean",
                "build-testing"
            ]
        },
        {
            "type": "shell",
            "label": "build-e2e-testing",
            "detail": "Builds E2E tests",
            "group": "test",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--preset",
                "build-e2e-testing"
            ],
            "dependsOn": [
                "config-ninja-debug"
            ]
        },
        {
            "type": "shell",
            "label": "build-e2e-testing-clean",
            "detail": "Cleans and builds E2E tests",
            "group": "test",
            "dependsOn": [
                "clean",
                "build-e2e-testing"
            ]
        },
        {
            "type": "shell",
            "label": "build-ninja-debug",
            "detail": "Builds the compiler with Ninja in debug mode.",
            "group": "build",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--preset",
                "build-ninja-debug"
            ],
            "dependsOn": [
                "config-ninja-debug"
            ]
        },
        {
            "type": "shell",
            "label": "build-ninja-debug-clean",
            "detail": "Cleans and builds the compiler with Ninja in debug mode.",
            "group": "build",
            "dependsOn": [
                "clean",
                "build-ninja-debug"
            ]
        },
        {
            "type": "shell",
            "label": "config-makefiles-debug",
            "detail": "Runs cmake with the config-makefiles-debug preset",
            "command": "cmake",
            "group": "build",
            "args": [
                "--preset",
                "config-makefiles-debug"
            ]
        },
        {
            "type": "shell",
            "label": "config-makefiles-debug-clean",
            "detail": "Runs clean and cmake with the config-makefiles-debug preset",
            "group": "build",
            "command": "cmake",
            "args": [
                "--preset",
                "config-makefiles-debug"
            ],
            "dependsOn": [
                "clean"
            ]
        },
        {
            "type": "shell",
            "label": "build-makefiles-debug",
            "detail": "Builds the compiler with Makefiles in debug mode.",
            "group": "build",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--preset",
                "build-makefiles-debug"
            ],
            "dependsOn": [
                "config-makefiles-debug"
            ]
        },
        {
            "type": "shell",
            "label": "build-makefiles-debug-clean",
            "detail": "Cleans and builds the compiler with Makefiles in debug mode.",
            "group": "build",
            "dependsOn": [
                "clean",
                "build-makefiles-debug"
            ]
        },
        {
            "type": "shell",
            "label": "clean",
            "detail": "Removes all build binaries and cache files.",
            "group": "build",
            "command": "rm",
            "args": [
                "-rf",
                "build/CMakeCache.txt",
                "build/CMakeFiles",
                "build/compiler",
                "build/testing",
                "build/e2e-testing",
            ]
        }
    ]
}